{
  "name": "cutsbymo-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "cutsbymo.espacios.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cutsbymo-media"
    }
  ]
}
